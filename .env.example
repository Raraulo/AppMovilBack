# .env.example
# Copia este archivo como .env y completa los valores para desarrollo local
# En Render, configura estas variables en el panel de Environment Variables

# ============================================================
# 🔑 SEGURIDAD
# ============================================================
# Genera una clave con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-secret-key-aqui

# ============================================================
# 🗄️ BASE DE DATOS (Supabase PostgreSQL)
# ============================================================
# Obtén la URL desde: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Formato: postgresql://postgres.xxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ============================================================
# 📧 EMAIL (Resend)
# ============================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxx

# ============================================================
# ⚙️ DJANGO
# ============================================================
# Cambiar a perfumeria.settings_production en Render
DJANGO_SETTINGS_MODULE=perfumeria.settings

# ============================================================
# 🚀 RENDER (solo en producción — Render lo setea automáticamente)
# ============================================================
# RENDER=true
